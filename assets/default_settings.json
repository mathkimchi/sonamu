{
  "$schema": "settings.schema.json",
  "palette": {
    "bg": "#000000",
    "fg": "#dfdfdf",
    "accent": "#ffff00",
    "inactive": "#707580"
  },
  "border": {
    "width": 2.0,
    "focused": "#00ff00",
    "unfocused": "#3b4049",
    "treeview": "#3b4049"
  },
  "gap": 8.0,
  "radius": 12.0,
  "always_frame": true,
  "font_size": 24.0,
  "mipmaps": true,
  "buffer_line": "buffer_mode",
  "treeview": {
    "side": "left",
    "width": 20,
    "floating": "center",
    "floating_size": [40, 70]
  },
  "swipe": {
    "distance_x": 600.0,
    "distance_y": 1200.0,
    "rubber_band": 0.15,
    "stiffness": 1000.0,
    "damping_ratio": 1.0
  },
  "zoom_out": { "child_previews": true, "view": "free" },
  "notifications": { "timeout": 5.0 },
  "keybinds": [
    {"mods": ["ctrl", "shift"], "key": "q", "command": "quit"},
    {"mods": ["logo"], "key": "w", "command": "close"},
    {"mods": ["logo"], "key": "t", "command": "spawn_terminal"},
    {"mods": ["logo", "shift"], "key": "t", "command": "spawn_terminal_sibling"},
    {"mods": ["logo"], "key": "n", "command": "spawn_browser"},
    {"mods": ["logo", "shift"], "key": "n", "command": "spawn_browser_sibling"},
    {"mods": ["logo"], "key": "p", "command": "wrap_project"},
    {"mods": ["logo"], "key": "f", "command": "toggle_half"},
    {"mods": ["alt", "shift"], "key": "w", "command": "swap_sibling", "args": [-1]},
    {"mods": ["alt", "shift"], "key": "s", "command": "swap_sibling", "args": [1]},
    {"mods": ["alt"], "key": "p", "command": "pluck_place"},
    {"mods": ["logo", "shift"], "key": "?", "command": "help"},
    {"mods": ["logo"], "key": "v", "command": "view_root"},
    {"mods": ["alt"], "key": "r", "command": "view_parent"},
    {"mods": ["ctrl", "logo"], "key": "left", "command": "swipe", "args": ["left"]},
    {"mods": ["ctrl", "logo"], "key": "right", "command": "swipe", "args": ["right"]},
    {"mods": ["ctrl", "logo"], "key": "up", "command": "swipe", "args": ["up"]},
    {"mods": ["ctrl", "logo"], "key": "down", "command": "swipe", "args": ["down"]},
    {"mods": ["alt"], "key": "tab", "command": "traverse", "args": ["next"]},
    {"mods": ["alt", "shift"], "key": "tab", "command": "traverse", "args": ["prev"]},
    {"mods": ["alt"], "key": "a", "command": "traverse", "args": ["parent"]},
    {"mods": ["alt"], "key": "0", "command": "traverse", "args": ["parent"]},
    {"mods": ["alt"], "key": "1", "command": "traverse", "args": ["child", 1]},
    {"mods": ["alt"], "key": "2", "command": "traverse", "args": ["child", 2]},
    {"mods": ["alt"], "key": "3", "command": "traverse", "args": ["child", 3]},
    {"mods": ["alt"], "key": "4", "command": "traverse", "args": ["child", 4]},
    {"mods": ["alt"], "key": "5", "command": "traverse", "args": ["child", 5]},
    {"mods": ["alt"], "key": "6", "command": "traverse", "args": ["child", 6]},
    {"mods": ["alt"], "key": "7", "command": "traverse", "args": ["child", 7]},
    {"mods": ["alt"], "key": "8", "command": "traverse", "args": ["child", 8]},
    {"mods": ["alt"], "key": "9", "command": "traverse", "args": ["last_child"]},
    {"mods": ["alt"], "key": "d", "command": "traverse", "args": ["recent_child"]},
    {"mods": ["alt"], "key": "w", "command": "traverse", "args": ["sibling", -1]},
    {"mods": ["alt"], "key": "s", "command": "traverse", "args": ["sibling", 1]},
    {"mods": ["alt"], "key": "enter", "command": "traverse", "args": ["enter"]}
  ],
  "restore_programs": [],
  "startup": [],
  "terminal": null,
  "browser": null,
  "pdf_viewer": null
}
