{
  "$schema": "settings.schema.json",
  "palette": {
    "bg": "#000000",
    "fg": "#dfdfdf",
    "accent": "#ffff00",
    "inactive": "#707580"
  },
  "border": {
    "width": 2.0,
    "focused": "#00ff00",
    "unfocused": "#3b4049",
    "treeview": "#3b4049"
  },
  "gap": 8.0,
  "radius": 12.0,
  "always_frame": true,
  "font_size": 24.0,
  "buffer_line": "buffer_mode",
  "treeview": {
    "side": "left",
    "width": 20,
    "floating": "center",
    "floating_size": [40, 70]
  },
  "swipe": {
    "distance_x": 600.0,
    "distance_y": 1200.0,
    "rubber_band": 0.15,
    "stiffness": 1000.0,
    "damping_ratio": 1.0
  },
  "zoom_out": { "child_previews": true, "view": "free" },
  "keybinds": [],
  "restore_programs": [],
  "startup": [],
  "terminal": null,
  "browser": null,
  "pdf_viewer": null
}
