#!/usr/bin/env python3
# Builds sonamu settings from DankMaterialShell's generated colors and settings.
import json
from pathlib import Path

colors_path = Path.home() / ".cache/DankMaterialShell/dms-colors.json"
dms_settings_path = Path.home() / ".config/DankMaterialShell/settings.json"

dms_colors = json.loads(colors_path.read_text())
dms_settings = json.loads(dms_settings_path.read_text())

colors = dms_colors["colors"][dms_colors["mode"]]
# the first bar's settings (its font scale is what DMS's scale setting changes here)
bar = (dms_settings.get("barConfigs") or [{}])[0]

print(json.dumps({
    "$schema": "https://raw.githubusercontent.com/mathkimchi/sonamu/dev/assets/settings.schema.json",
    "palette": {
        "bg": colors["background"],
        "fg": colors["on_surface"],
        # focus on a node itself (traversing), so it differs from border.focused
        "accent": colors["tertiary"],
        "inactive": colors["outline"],
    },
    "border": {
        # DMS's "Focused Border" (workspace appearance)
        "width": dms_settings.get("workspaceFocusedBorderThickness", 2)
        if dms_settings.get("workspaceFocusedBorderEnabled", False)
        else 0,
        "focused": colors["primary"],
        "unfocused": colors["outline_variant"],
        "treeview": colors["secondary"],
    },
    "gap": 8.0,
    "radius": dms_settings.get("cornerRadius", 12),
    # physical px; Sonamu's own UI isn't scaled
    "font_size": 24.0 * bar.get("fontScale", 1.0),
    # pinned on the left (the treeview's pin button pins it); unpinned, it floats over the middle of the panes
    "treeview": {
        "side": "left",
        "floating": "center",
        "width": 15,  # the pinned column's, in percent of the window's width
        "floating_size": [50, 70],  # a center floating one's width and height, in percent of the window's
    },
    # the buffer line (Luau prompt, Super+Esc) always at the bottom, `INSERT` while not in it
    "buffer_line": "always",
    "swipe": {
        "distance_x": 600.0,
        "distance_y": 1200.0,
        "rubber_band": 0.15,
        "stiffness": 1000.0,
        "damping_ratio": 1.0,
    },
    # evdev key codes
    "keybinds": [
        {"key": 115, "command": "wpctl set-volume -l 1 @DEFAULT_AUDIO_SINK@ 5%+"},  # volume up
        {"key": 114, "command": "wpctl set-volume @DEFAULT_AUDIO_SINK@ 5%-"},  # volume down
        {"key": 113, "command": "wpctl set-mute @DEFAULT_AUDIO_SINK@ toggle"},  # mute
        {"key": 225, "command": "brightnessctl set 5%+"},  # brightness up
        {"key": 224, "command": "brightnessctl set 5%-"},  # brightness down
        # {"key": 99, "command": "dms screenshot"},  # Print: select a region
        # {"key": 99, "command": "grim -g \"$(slurp)\" - | wl-copy"},  # screenshot and copy, this is the Prt Sc key
        # {"key": 99, "command": "grim - | swappy -f -"},  # screenshot and edit with swappy, this is the Prt Sc key
        {"key": 99, "command": "grim"},  # swappy is broken bro
        {"mods": ["logo", "shift"], "key": "r", "command": str(Path(__file__).parent / "toggle-record")},
    ],
    # programs restored running in their terminal; for others, the restored terminal asks first
    "restore_programs": ["hx", {"program": "claude", "args": ["--continue"]}, "typst"],
    # started by Super+T / Super+N
    "terminal": "foot",
    "browser": "firefox",
    # run once when Sonamu starts
    "startup": ["dms run"],
    "watch": [str(colors_path), str(dms_settings_path)],
    "zoom_out": [6, 5],
}, indent=2))
